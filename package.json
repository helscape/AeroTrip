{
  "name": "aerotrip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AeroTrip — flight search and booking app (Preact + FastAPI + MariaDB).",
  "scripts": {
    "start": "./run.sh",
    "dev": "vite",
    "dev:api": "cd server && .venv/bin/python -m uvicorn app.main:app --reload --port 3001",
    "dev:all": "bun run dev:api & bun run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed": "cd server && .venv/bin/python seed.py",
    "test:api": "cd server && .venv/bin/python -m pytest"
  },
  "dependencies": {
    "lucide-preact": "^0.400.0",
    "preact": "^10.24.0",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
