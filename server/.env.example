# SQLAlchemy URL for MariaDB (PyMySQL driver).
DATABASE_URL=mysql+pymysql://aerotrip:<password>@localhost:3306/aerotrip?charset=utf8mb4
# Separate database used by pytest (never point this at production data).
TEST_DATABASE_URL=mysql+pymysql://aerotrip:<password>@localhost:3306/aerotrip_test?charset=utf8mb4
# Value required in the x-admin-key header for /api/admin/* endpoints.
ADMIN_API_KEY=change-me
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
# Secret used to sign JWT access tokens (HS256). Use a long random value, e.g.
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-hex-string
# Access token lifetime in hours.
JWT_TTL_HOURS=168
